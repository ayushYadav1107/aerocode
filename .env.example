# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# MongoDB connection string (Prisma requires a replica set; Atlas provides one)
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/aerocode?retryWrites=true&w=majority"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app -> callback: <origin>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Google OAuth client -> callback: <origin>/api/auth/callback/google
GOOGLE_ID=""
GOOGLE_SECRET=""

# --- AI -------------------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=""

# Optional. Must be a model your key can access (see docs/setup.md).
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_TIMEOUT_MS="30000"

# --- Optional -------------------------------------------------------------
# Lifts GitHub's 60 req/hr unauthenticated limit for repository imports
# GITHUB_TOKEN=""
